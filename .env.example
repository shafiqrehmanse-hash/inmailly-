# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App URL (production)
NEXT_PUBLIC_APP_URL=https://inmailly.com

# Google Search Console — paste the content value from the HTML meta tag verification method
GOOGLE_SITE_VERIFICATION=

# AdsPower local pilot (scripts/adspower-open-profile.mjs)
# ADSPOWER_API_KEY=
# ADSPOWER_USER_ID=
# ADSPOWER_BASE_URL=http://local.adspower.net:50325

# Resend (https://resend.com) — required for signup/verification emails
# 1. Add and verify your domain at resend.com/domains
# 2. Set EMAIL_FROM to an address on that domain
# 3. Set NOTIFY_EMAIL to your inbox (admin alerts on signup + verify)
RESEND_API_KEY=
EMAIL_FROM=InMailly <notifications@inmailly.com>
NOTIFY_EMAIL=hello@inmailly.com

# Intelligence InMail (Work Links → paste profile screenshot)
OPENAI_API_KEY=
# OPENAI_VISION_MODEL=gpt-4o-mini

# Reply Assistant (LinkedIn thread replies) — separate name; same sk- key is fine
# REPLY_ASSISTANT_OPENAI_API_KEY=
# REPLY_ASSISTANT_OPENAI_VISION_MODEL=gpt-4o-mini

# Reply Assistant — booking link for "Meeting link reply"
# REPLY_ASSISTANT_MEETING_LINK=https://calendly.com/your-link
